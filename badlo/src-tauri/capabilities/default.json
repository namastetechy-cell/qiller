{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local-only permissions for Badlo windows",
  "windows": ["settings", "popup"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-set-theme",
    "dialog:allow-open"
  ]
}
